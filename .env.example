# =============================================================================
# Gratia AI Solutions — Environment Variables
# Add each of these in Vercel → Project → Settings → Environment Variables.
# For local dev, copy this file to `.env.local` and fill in the values.
# =============================================================================

# --- Database: Neon Postgres ---
# The Vercel Neon integration auto-adds a set of prefixed vars, e.g.:
#   database_new_DATABASE_URL, database_new_POSTGRES_URL,
#   database_new_DATABASE_URL_UNPOOLED, database_new_POSTGRES_URL_NON_POOLING, ...
# The app reads any of those automatically (see lib/db/index.ts) — you do NOT
# need to rename them in Vercel. For LOCAL dev, just set DATABASE_URL below to
# the pooled Neon connection string (include ?sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- File storage: Vercel Blob ---
# Auto-populated when you create a Blob store in Vercel (Storage tab).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX

# --- Telegram portfolio bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz   # from @BotFather
TELEGRAM_ADMIN_ID=123456789                                # your numeric id from @userinfobot (bot is admin-only)

# (Contact form needs no key — it opens the visitor's email app via a mailto: link.)

# --- Public site URL (used in bot reply links & metadata) ---
# Use your real Vercel domain in production; http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Optional: shared secret protecting the internal /api/ai/process-project route ---
INTERNAL_API_SECRET=any-long-random-string

# --- Gemini (portfolio structuring + Albert the interviewer) ---
GEMINI_API_KEY=AIza...                          # https://aistudio.google.com/apikey (free tier)
# GEMINI_MODEL=gemini-2.5-flash-lite            # optional: portfolio bot model
# GEMINI_ALBERT_MODEL=gemini-2.5-flash          # optional: Albert's model

# --- Accounts (Better Auth: Google + email/password) ---
BETTER_AUTH_SECRET=                             # `openssl rand -base64 32`
BETTER_AUTH_URL=https://your-project.vercel.app # same as NEXT_PUBLIC_SITE_URL
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave both empty to offer email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Build pipeline (GitHub Actions + Claude Code) — see README "Albert & the build pipeline" ---
GITHUB_TOKEN=github_pat_...                     # fine-grained PAT, resource owner = the build org
GITHUB_BUILD_ORG=gratia-builds                  # org that holds client repos
GITHUB_TEMPLATE_REPO=gratia-builds/gratia-build-template
BUILD_CALLBACK_SECRET=                          # `openssl rand -hex 32`; same value as the org secret
CRON_SECRET=                                    # any long random string; Vercel sends it to /api/builds/tick
